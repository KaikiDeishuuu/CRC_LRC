[Unit]
Description=CRC/LRC Checksum Calculator API
Documentation=https://github.com/yourname/checksum-api
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/home/GoProjects/WebAPI/CRC_LRC
ExecStart=/home/GoProjects/WebAPI/CRC_LRC/bin/checksum-api
Restart=always
RestartSec=10
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=checksum-api

# 环境变量
Environment="PORT=8080"

# 安全配置
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/home/GoProjects/WebAPI/CRC_LRC/logs

# 资源限制
LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=multi-user.target

# 安装说明:
# 1. 复制此文件到: sudo cp checksum-api.service /etc/systemd/system/
# 2. 重载 systemd: sudo systemctl daemon-reload
# 3. 启用服务: sudo systemctl enable checksum-api
# 4. 启动服务: sudo systemctl start checksum-api
# 5. 查看状态: sudo systemctl status checksum-api
# 6. 查看日志: sudo journalctl -u checksum-api -f
