server:
  port: 8080
  readTimeout: 5s
  writeTimeout: 10s
  idleTimeout: 15s
  maxHeaderBytes: 1048576 # 1MB

log:
  level: info # debug, info, warn, error

checksum:
  maxInputLengthBytes: 1048576 # 1MB
  maxFileUploadSizeMB: 10 # 10MB

telegram:
  enabled: false # 启用/禁用 Telegram 通知
  botToken: "YOUR_BOT_TOKEN_HERE" # 从 @BotFather 获取
  chatId: "YOUR_CHAT_ID_HERE" # 从 @userinfobot 获取（你的用户 ID）
  timeout: 5s # 通知请求超时时间
